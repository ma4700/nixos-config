\newfontfamily\greekfont{Libertinus Serif}[Ligatures=TeX]
\usepackage{unicode-math}
\setmathfont{Libertinus Math}

\usepackage{hyperref}
\hypersetup{hidelinks}

\sisetup{
  uncertainty-mode      = separate,
  separate-uncertainty-units = repeat,
  range-phrase          = {\,--\,},
  range-units           = single,
  mode                  = match,  % αριθμοί με τη γραμματοσειρά του κειμένου
  reset-text-series     = false,  % έντονοι μέσα σε έντονο κείμενο
}
\DeclareSIUnit{\molar}{M}

% ==================== Στοιχεία αναφοράς ====================
\newcommand{\labcourse}{Όνομα μαθήματος}
\newcommand{\labno}{Άσκηση Χ}
\newcommand{\labtitle}{Ονομασία πειράματος}
\newcommand{\labauthors}{Ονοματεπώνυμο}
\newcommand{\labid}{ΑΜ}
\newcommand{\labbench}{Χ}
\newcommand{\labdate}{\today}  % ημερομηνία

% ==================== Μορφή σελίδας ====================
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\labcourse}
\fancyhead[R]{\small\labtitle}
\fancyfoot[C]{\small\thepage}

% ==================== Εντολές αναφοράς ====================
% \labstep{Τίτλος}        νέο αριθμημένο βήμα (Βήμα 1, 2, ...)
% \labpart{Τίτλος}        υποτίτλος μέσα σε βήμα (Περιγραφή, Μετρήσεις, ...)
% \labcompare[μονάδα]{μέγεθος}{πειραματική}{αναμενόμενη}{προβλεπόμενο σφάλμα %}
%     υπολογίζει ε = |πειρ. − αναμ.| / |αναμ.| · 100 και το συγκρίνει με το όριο.
%     Τιμές ως σκέτοι αριθμοί με τελεία (π.χ. 0.0962 ή 9.62e-2), αναμενόμενη ≠ 0.
%     Απόλυτο σφάλμα δx → όριο σε %: δx / x · 100.
% \begin{improve} ... \end{improve}
%     πλαίσιο «Περιθώρια βελτίωσης»· μπαίνει μετά τις συγκρίσεις του βήματος.
% \labsummary             πίνακας με όλες τις συγκρίσεις της αναφοράς

\newcounter{labstep}
\newcommand{\labstepheading}[1]{\subsection*{Βήμα~\thelabstep: #1}}
\newcommand{\labpart}[1]{\par\addvspace{\medskipamount}\noindent\textbf{#1}\par\nobreak}

\newcommand{\labvalue}[2]{%
  \if\relax\detokenize{#2}\relax\num{#1}\else\SI{#1}{#2}\fi}
\newcommand{\labpercent}[1]{%
  \SI[round-mode=places,round-precision=2]{#1}{\percent}}

\newcommand{\labcompareblock}[7]{%
  \par\smallskip\noindent
  \begin{tabular}{@{}l@{\quad}l@{}}
    \multicolumn{2}{@{}l}{\textbf{Σύγκριση: #1}}\\[0.2em]
    Πειραματική τιμή:     & \labvalue{#3}{#2}\\
    Αναμενόμενη τιμή:     & \labvalue{#4}{#2}\\
    Σχετικό σφάλμα:       & $\varepsilon = \labpercent{#5}$
                            \quad (προβλεπόμενο: $\le \SI{#6}{\percent}$)\\
    Αξιολόγηση:           & \ifnum#7=1 \textbf{εκτός ορίου}\else εντός ορίου\fi
  \end{tabular}\par\smallskip}

\newcommand{\labsummaryrow}[8]{%
  #1 & #2 & \labvalue{#4}{#3} & \labvalue{#5}{#3} & \labpercent{#6}
  & \SI{#7}{\percent} & \ifnum#8=1 \textbf{εκτός}\else εντός\fi \\}

\ExplSyntaxOn
\fp_new:N   \l__lab_err_fp
\bool_new:N \l__lab_out_bool
\tl_new:N   \g__lab_rows_tl

\NewDocumentCommand \labstep { m }
  {
    \refstepcounter { labstep }
    \labstepheading {#1}
  }

\NewDocumentCommand \labcompare { O{} m m m m }
  {
    \fp_set:Nn \l__lab_err_fp { abs( (#3) - (#4) ) / abs(#4) * 100 }
    \fp_compare:nNnTF \l__lab_err_fp > {#5}
      { \bool_set_true:N  \l__lab_out_bool }
      { \bool_set_false:N \l__lab_out_bool }
    \use:x
      {
        \exp_not:N \labcompareblock
          { \exp_not:n {#2} } { \exp_not:n {#1} }
          { \exp_not:n {#3} } { \exp_not:n {#4} }
          { \fp_use:N \l__lab_err_fp } { \exp_not:n {#5} }
          { \bool_if:NTF \l__lab_out_bool { 1 } { 0 } }
      }
    \tl_gput_right:Nx \g__lab_rows_tl
      {
        \exp_not:N \labsummaryrow
          { \int_use:c { c@labstep } }
          { \exp_not:n {#2} } { \exp_not:n {#1} }
          { \exp_not:n {#3} } { \exp_not:n {#4} }
          { \fp_use:N \l__lab_err_fp } { \exp_not:n {#5} }
          { \bool_if:NTF \l__lab_out_bool { 1 } { 0 } }
      }
  }

\NewExpandableDocumentCommand \labsummaryrows { }
  { \g__lab_rows_tl }
\ExplSyntaxOff

\NewDocumentEnvironment{improve}{+b}{%
  \par\medskip\noindent
  \fcolorbox{black!70}{white}{%
    \begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}
      \textbf{Περιθώρια βελτίωσης}\par\smallskip
      #1
    \end{minipage}}%
  \par\medskip}{}

\newcommand{\labsummary}{%
  \begin{table}[H]
    \centering
    \caption{Σύνοψη συγκρίσεων με τις αναμενόμενες τιμές}
    \begin{tabular}{c l r r r r l}
      \toprule
      Βήμα & Μέγεθος & Πειραματική & Αναμενόμενη & $\varepsilon$ & Όριο & Αξιολόγηση\\
      \midrule
      \labsummaryrows
      \bottomrule
    \end{tabular}
  \end{table}}

